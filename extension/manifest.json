{
  "manifest_version": 3,
  "name": "Tunnelka",
  "version": "1.0.0",
  "description": "Браузер через VPN: через приложение Tunnelka (VLESS, VMess, Trojan, Hysteria2…) или через свой HTTP/SOCKS5-прокси. Выбор сайтов.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tunnelka",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "privacy",
    "activeTab",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
